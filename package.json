{
  "name": "timepass",
  "version": "0.5.0-beta",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/build-content.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/lib/*.test.ts scripts/lib/*.test.mjs",
    "check:content": "node scripts/build-content.mjs",
    "predev": "node scripts/build-content.mjs --quiet",
    "data:sync": "node scripts/sync-sheets.mjs",
    "data:db": "node --no-warnings scripts/content-db.mjs",
    "pretest": "node scripts/build-content.mjs --quiet"
  },
  "dependencies": {
    "next": "16.4.3",
    "posthog-js": "^1.438.22",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  },
  "type": "module"
}
